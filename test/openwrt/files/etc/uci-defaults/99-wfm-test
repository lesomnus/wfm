#!/bin/sh
# Self-provision a self-contained wfm test node. Baked into the image by
# build-image.sh, this runs once on first boot (uci-defaults) so the QEMU VM is
# ready without any ssh/scp step.
#
# Topology (all inside one VM, two mac80211_hwsim radios that hear each other):
#   - eth0  -> `mgmt` interface, DHCP. QEMU slirp hands it 10.0.2.15, which the
#              host reaches via -hostfwd; this is how wfm talks to /ubus.
#   - radio0 -> AP broadcasting WFMTEST, bridged to `lan` (dnsmasq serves DHCP).
#   - radio1 -> left free for wfm to manage as a station bound to `wwan` (DHCP);
#              it associates to radio0's AP and gets an address from lan's dnsmasq.
#
# NOTE: the exact radio/section names and options here are best-effort and are
# what the harness exists to validate; adjust after the first real boot if the
# node names its devices differently.

SSID='WFMTEST'
KEY='wfmtest123'
ROOT_PW='wfmtest'

# Generate wireless sections for the detected radios if none exist yet.
[ -s /etc/config/wireless ] || /sbin/wifi config

uci -q batch <<EOF
# --- management NIC: reachable from the host through QEMU slirp -------------
delete network.mgmt
set network.mgmt='interface'
set network.mgmt.device='eth0'
set network.mgmt.proto='dhcp'

# --- lan: wifi-only bridge that runs DHCP for associated stations -----------
del_list network.lan.ports='eth0'
delete network.lan.device
set network.lan='interface'
set network.lan.proto='static'
set network.lan.ipaddr='192.168.66.1'
set network.lan.netmask='255.255.255.0'

# --- wwan: DHCP client the wfm-managed station binds to ----------------------
delete network.wwan
set network.wwan='interface'
set network.wwan.proto='dhcp'
commit network
EOF

uci -q batch <<EOF
# --- radio0 as the test AP ---------------------------------------------------
set wireless.radio0.disabled='0'
set wireless.radio0.channel='1'
set wireless.radio0.band='2g'
delete wireless.default_radio0
set wireless.default_radio0='wifi-iface'
set wireless.default_radio0.device='radio0'
set wireless.default_radio0.network='lan'
set wireless.default_radio0.mode='ap'
set wireless.default_radio0.ssid='$SSID'
set wireless.default_radio0.encryption='psk2'
set wireless.default_radio0.key='$KEY'
# --- radio1: enabled but no iface, so wfm creates the station on it ----------
set wireless.radio1.disabled='0'
delete wireless.default_radio1
commit wireless
EOF

# Ensure dnsmasq serves DHCP on lan (default OpenWrt lan dhcp pool).
uci -q batch <<EOF
set dhcp.lan='dhcp'
set dhcp.lan.interface='lan'
set dhcp.lan.start='100'
set dhcp.lan.limit='100'
set dhcp.lan.leasetime='1h'
commit dhcp
EOF

# Serve ubus over HTTP at /ubus (uhttpd-mod-ubus).
uci -q set uhttpd.main.ubus_prefix='/ubus'
uci -q commit uhttpd

# rpcd's default `root` login defers to the system password ($p$root) with
# full ACLs, so setting root's password is all that is needed for wfm to log in.
printf '%s\n%s\n' "$ROOT_PW" "$ROOT_PW" | passwd root >/dev/null 2>&1

exit 0
