#!/bin/sh
# Self-provision a self-contained wfm test node. Baked into the image by
# build-image.sh, this runs once on first boot (uci-defaults) so the QEMU VM is
# ready with no ssh/scp step.
#
# Design: stay WITH the default `lan` config instead of carving out a separate
# management interface. eth0 stays in the lan bridge and lan's firewall zone
# (input ACCEPT), so uhttpd/ubus on :80 is reachable; switching lan to a DHCP
# client makes QEMU slirp hand eth0 10.0.2.15, which the host reaches via
# -hostfwd. radio0 becomes the test AP; radio1 is left free for wfm to manage as
# a station.
#
# NOTE: exact radio/section names are what the harness validates; adjust after a
# real boot if the node names its devices differently. The final marker line is
# echoed to the console so the serial log confirms this ran.

SSID='WFMTEST'
KEY='wfmtest123'
ROOT_PW='wfmtest'

[ -s /etc/config/wireless ] || /sbin/wifi config

# lan as a DHCP client -> eth0 gets 10.0.2.15 from slirp, reachable from the
# host; it stays in the lan zone so the firewall keeps :80 open.
uci -q set network.lan.proto='dhcp'
# A network the wfm-managed station binds to. There is no DHCP server on the
# wifi side, so association (not an address) is what the test asserts.
uci -q delete network.wwan
uci -q set network.wwan='interface'
uci -q set network.wwan.proto='dhcp'
uci -q commit network

uci -q batch <<EOF
set wireless.radio0.disabled='0'
set wireless.radio0.channel='1'
set wireless.radio0.band='2g'
delete wireless.default_radio0
set wireless.default_radio0='wifi-iface'
set wireless.default_radio0.device='radio0'
set wireless.default_radio0.network='lan'
set wireless.default_radio0.mode='ap'
set wireless.default_radio0.ssid='$SSID'
set wireless.default_radio0.encryption='psk2'
set wireless.default_radio0.key='$KEY'
set wireless.radio1.disabled='0'
delete wireless.default_radio1
commit wireless
EOF

# Serve ubus over HTTP at /ubus (uhttpd-mod-ubus).
uci -q set uhttpd.main.ubus_prefix='/ubus'
uci -q commit uhttpd

# rpcd's default `root` login defers to the system password with full ACLs, so
# setting root's password is all wfm needs to log in.
printf '%s\n%s\n' "$ROOT_PW" "$ROOT_PW" | passwd root >/dev/null 2>&1

echo "wfm-uci-defaults: provisioned ssid=$SSID" > /dev/console
exit 0
